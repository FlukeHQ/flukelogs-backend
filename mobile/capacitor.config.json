{
  "appId": "com.flukesend.flukelogs",
  "appName": "Flukelogs",
  "webDir": "www",
  "server": {
    "url": "https://trip-logger-backend.vercel.app/?shell=safe-areas",
    "cleartext": false,
    "allowNavigation": [
      "trip-logger-backend.vercel.app"
    ]
  },
  "ios": {
    "contentInset": "never",
    "limitsNavigationsToAppBoundDomains": false
  },
  "android": {
    "useLegacyBridge": true,
    "allowMixedContent": false
  },
  "packageClassList": [
    "BackgroundGeolocation",
    "LiveActivityPlugin"
  ]
}
